<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp 
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:type="TaskPaneApp">

  <Id>7a9c8b5d-4e3f-2a1b-9c8d-7e6f5a4b3c2d</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Dálmerson Lima (PQ Web Simulator)</ProviderName>
  <DefaultLocale>pt-BR</DefaultLocale>
  
  <DisplayName DefaultValue="PQ Web Simulator" />
  <Description DefaultValue="Simulador de Power Query para Excel Web gratuito" />
  
  <!-- Ícones placeholders -->
  <IconUrl DefaultValue="https://via.placeholder.com/32" />
  <HighResolutionIconUrl DefaultValue="https://via.placeholder.com/80" />

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <!-- ATENÇÃO: Este link será substituído pelo link do GitHub Pages depois -->
  <DefaultSettings>
    <SourceLocation DefaultValue="https://SEU-USUARIO.github.io/pq-web-simulator/index.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>